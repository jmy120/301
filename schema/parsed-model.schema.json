{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sysml-parser.local/schema/parsed-model-1.2.0.json",
  "title": "ParsedModel v1.2.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "source",
    "elements",
    "relations",
    "diagrams",
    "views",
    "issues",
    "statistics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "fileName",
        "encoding"
      ],
      "properties": {
        "fileName": {
          "type": "string"
        },
        "encoding": {
          "type": "string"
        },
        "xmiVersion": {
          "type": "string"
        },
        "productVersion": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modelElement",
        "unevaluatedProperties": false
      }
    },
    "relations": {
      "description": "Semantic relations and diagram links. AssociationClass retains classifier children here alongside association endpoints; InformationFlow retains payload/realization references.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "diagrams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagram"
      }
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extensionNode"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parseIssue"
      }
    },
    "statistics": {
      "$ref": "#/$defs/statistics"
    },
    "indexes": {
      "$ref": "#/$defs/indexes"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "modelElement": {
      "type": "object",
      "required": [
        "id",
        "metaClass",
        "childrenIds",
        "stereotypes",
        "attributes",
        "sourceXPath"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "metaClass": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "qualifiedName": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "childrenIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stereotypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "references": { "$ref": "#/$defs/featureValues" },
        "textValues": { "$ref": "#/$defs/featureValues" },
        "sourceXPath": {
          "type": "string"
        }
      }
    },
    "relation": {
      "allOf": [
        {
          "$ref": "#/$defs/modelElement"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "relationOrigin",
            "endIds"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "relationOrigin": {
              "enum": [
                "semantic",
                "diagram"
              ]
            },
            "sourceId": {
              "type": "string"
            },
            "targetId": {
              "type": "string"
            },
            "sourceIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "targetIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "roleIds": {
              "type": "array",
              "items": { "type": "string" }
            },
        "endIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "direction": {
              "type": "string"
            },
            "sourceLifelineIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "targetLifelineIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "diagram": {
      "allOf": [
        {
          "$ref": "#/$defs/modelElement"
        },
        {
          "type": "object",
          "required": [
            "type",
            "viewIds"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "rootViewId": {
              "type": "string"
            },
            "imageRef": {
              "type": "string"
            },
            "viewIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "view": {
      "type": "object",
      "required": [
        "id",
        "diagramId",
        "presentationKind",
        "kind",
        "style",
        "sourceXPath"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "diagramId": {
          "type": "string"
        },
        "modelElementId": {
          "type": "string"
        },
        "modelElementScope": {
          "enum": [
            "element",
            "relation",
            "diagram",
            "external",
            "unresolved"
          ]
        },
        "presentationKind": {
          "enum": [
            "graphic",
            "diagram-structure"
          ]
        },
        "kind": {
          "type": "string"
        },
        "bounds": {
          "type": "string"
        },
        "waypoints": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "style": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "sourceXPath": {
          "type": "string"
        },
        "sourceViewId": {
          "type": "string"
        },
        "targetViewId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "extensionNode": {
      "type": "object",
      "required": [
        "tag",
        "metaClass",
        "attributes",
        "sourceXPath"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "metaClass": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "references": { "$ref": "#/$defs/featureValues" },
        "textValues": { "$ref": "#/$defs/featureValues" },
        "sourceXPath": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "parseIssue": {
      "type": "object",
      "required": [
        "stage",
        "code",
        "severity",
        "message",
        "xpath"
      ],
      "properties": {
        "stage": {
          "const": "parse"
        },
        "code": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "message": {
          "type": "string"
        },
        "xpath": {
          "type": "string"
        },
        "elementId": {
          "type": "string"
        },
        "referenceId": {
          "type": "string"
        },
        "diagramId": {
          "type": "string"
        },
        "viewId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "featureValues": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "statistics": {
      "type": "object",
      "required": [
        "elements",
        "relations",
        "diagrams",
        "views",
        "danglingReferences",
        "duplicateIds"
      ],
      "properties": {
        "elements": {
          "type": "integer",
          "minimum": 0
        },
        "relations": {
          "type": "integer",
          "minimum": 0
        },
        "diagrams": {
          "type": "integer",
          "minimum": 0
        },
        "views": {
          "type": "integer",
          "minimum": 0
        },
        "danglingReferences": {
          "type": "integer",
          "minimum": 0
        },
        "duplicateIds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "indexes": {
      "type": "object",
      "required": [
        "idsByFilePart",
        "externalReferences"
      ],
      "properties": {
        "idsByFilePart": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "externalReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "href",
              "id"
            ],
            "properties": {
              "href": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
